# DB_CONNECTION=sqlite
# DB_DATABASE=database.sqlite

## Docker Setup
DB_CONNECTION=mysql
# JANGAN gunakan 127.0.0.1. Gunakan nama service kontainer MySQL Anda
DB_HOST=mysql
# Gunakan port internal Docker (3306), BUKAN port eksternal (3307)
DB_PORT=3306
DB_DATABASE=php_microdata_server
# Gunakan user non-root demi keselarasan data (atau 'root')
DB_USERNAME=dev_user
# Isi dengan password yang Anda pasang di compose.yml
DB_PASSWORD=dev_password

CACHE_DRIVER=files
# CACHE_DRIVER=redis

# QUEUE_DRIVER=redis
QUEUE_DRIVER=mysql

SESSION_DRIVER=files
# SESSION_DRIVER=redis
SESSION_REGENERATE=300
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=ms

MB_CONNECTION=rabbitmq
MB_SCHEME=amqp
# MB_SCHEME=amqps
# Ganti dari 127.0.0.1 ke nama service di compose.yml
MB_HOST=rabbitmq
# Gunakan port internal RabbitMQ (5672), BUKAN port luar (5673)
MB_PORT=5672                
MB_USERNAME=guest
MB_PASSWORD=guest
MB_QUEUE_NAME=backend_php-queue

REDIS_CLIENT=phpredis
# Ganti dari 127.0.0.1 ke nama service di compose.yml
REDIS_HOST=redis
# Tetap null karena di compose.yml tidak dipasang password Redis
REDIS_PASSWORD=null
# Gunakan port internal Redis (6379), BUKAN port luar (6378)
REDIS_PORT=6379


MAIL_MAILER=mailpit
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

