{
    "name": "lutvip19/phpffi-cronjob",
    "license": "MIT",
    "description": "Simple cronjob system with PHP8-FFi.",
    "keywords": ["php8", "ffi", "cronjob"],
    "require": {
        "php": "^8.2",
        "phpstreamserver/scheduler": "^0.8.1",
        "meilisearch/meilisearch-php": "^1.16",        
        "php-http/curl-client": "^2.4",
        "nyholm/psr7": "^1.8",
        "php-amqplib/php-amqplib": "^3.7",
        "robinvdvleuten/ulid": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/inject_php.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
