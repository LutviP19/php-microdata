{
	# Global options
	frankenphp {
		num_threads 8
		php_ini {
			memory_limit 512M
			max_execution_time 15
			opcache.enable 1
			opcache.enable_cli 1
			opcache.memory_consumption 256
			opcache.interned_strings_buffer 16
			opcache.jit_buffer_size 64M
			opcache.jit tracing
		}
	}
	servers {
		trusted_proxies static 0.0.0.0/0
	}
	auto_https off
}

http://localhost:8000 {
	# Root (Gunakan tanda bintang)
	root * ./public/

	# === KONFIGURASI LOGGING TERPISAH (HUMAN READABLE & AUTO ROTATE) ===
	# 1. Log Akses Utama
	log {
		output file /data/logs/access.log {
			roll_size 5mb     # Potong file log jika ukuran mencapai 5MB
			roll_keep 3       # Simpan maksimal 3 file arsip log lama saja
			roll_keep_for 48h # Hapus otomatis arsip log setelah 2 hari
		}
		format console        # Format teks biasa yang rapi (mudah dibaca manusia)
	}

	encode zstd br gzip {
		minimum_length 1
	}

	# PRIORITAS UTAMA: API Worker
	handle_path /api/* {
		rewrite * /api.php
		php_server {
			worker {
				file ./public/api.php
				num 4
				# Watch perubahan isi file
				watch ./app/**/*.php ./config/**/*.php ./views/**/*.php ./static/**/*.php ./public/api.php
			}
			# 2. Log Eror Khusus untuk Endpoint API (Format default PHP Error Log)
			stderr file /data/logs/api_error.log
		}
	}

	# PRIORITAS KEDUA: Web/HTMX (index.php)
	handle {
		try_files {path} /index.php

		php_server {
			# 3. Log Eror Khusus untuk Aplikasi Web (Format default PHP Error Log)
			stderr file /data/logs/web_error.log
		}
	}

	# CORS Headers
	header {
		Access-Control-Allow-Origin "localhost,demo.test,demo.local,://app.com,192.168.0.100,[::1],127.0.0.1"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, X-Api-Key, HTTP_X_PMD_SIGNATURE,HTTP_X_PMD_TIMESTAMP, HX-Request, HX-Trigger, HX-Target, HX-Current-URL"
		Access-Control-Allow-Credentials "true"
		Vary Origin
	}

	@options {
		method OPTIONS
	}
	respond @options 204
}
