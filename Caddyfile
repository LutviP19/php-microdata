
{
    # Global options
    frankenphp {
        num_threads 3  # Sets the number of PHP threads to 3

        php_ini {
            memory_limit 1024M
            max_execution_time 15
        }
    }

    servers {
        # Allow all Local Network IP
        trusted_proxies static 0.0.0.0
    }

    # Development Only
    auto_https off
}


http://localhost:8000 {
	log

	# encode zstd br gzip
    
    # Active Compression
    # Caddy akan memilih otomatis: zstd (terbaik), br (brotli), atau gzip
    encode zstd br gzip {
        # Penting untuk streaming: kompresi tetap jalan meskipun data dikirim per baris
        minimum_length 1
    }

	root ./public/


    # Your normal PHP handling
	php_server {
        #hot_reload  config/**/*.php app/**/*{.php,.js} cron/**/*.php  static/**/*.php public/**/*{.css,.js}
        
		try_files {path} index.php
	}

    # Allow CORS if HTMX requests come from different subdomains
    header {
        # Samakan nilainya dari env ALLOWED_ORIGINS
        # Jika tidak ada di env, default ke '*'
        Access-Control-Allow-Origin "localhost,demo.test,demo.local,demo.app.com,192.168.0.100,[::1],127.0.0.1"

        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, X-Api-Key, HX-Request, HX-Trigger, HX-Target, HX-Current-URL"
        Access-Control-Allow-Credentials "true"

        # Memastikan browser tahu bahwa header ini bisa berubah tergantung origin
        Vary Origin
        
        # 'defer' memastikan header ini ditambahkan di akhir proses, 
        # menimpa header yang mungkin diset secara otomatis oleh PHP
        # defer
    }

    # Handle CORS preflight (OPTIONS) requests
    @options {
        method OPTIONS
    }
    respond @options 204
}